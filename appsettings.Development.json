{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "JwtSettings": {
    "Key": "DevelopmentJwtSigningKeyForLocalTestingOnly",
    "Issuer": "PaymobIntegrationDemo",
    "Audience": "PaymobIntegrationDemoUsers"
  },
  "Paymob": {
    "BaseUrl": "https://accept.paymob.com/api",
    "ApiKey": "your-development-paymob-api-key",
    "MerchantId": "your-development-merchant-id",
    "HmacSecret": "your-development-hmac-secret",
    "TimeoutSeconds": 30
  }
}
